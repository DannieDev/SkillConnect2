{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["jest", "node"],
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": false,
    "moduleResolution": "node"
  },
  "include": [
    "next-env.d.ts",
    "__tests__/**/*.ts",
    "__tests__/**/*.tsx",
    "test-setup/**/*.ts"
  ]
}
